{
  "name": "mcp-2048",
  "version": "0.1.0",
  "description": "MCP server that reads and plays 2048 in a browser with Puppeteer.",
  "private": true,
  "type": "module",
  "bin": {
    "mcp-2048": "./src/index.js"
  },
  "scripts": {
    "start": "node ./src/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test test/unit/*.test.js test/integration/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include='src/**/*.js' --test-coverage-lines=85 --test-coverage-branches=80 --test-coverage-functions=85 --test test/unit/*.test.js test/integration/*.test.js",
    "test:e2e": "node e2e/live.test.js",
    "check": "npm run lint && npm run format:check && npm run test:coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "puppeteer-core": "^25.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
